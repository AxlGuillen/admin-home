# Proyecto Supabase: Axl-Projects (impscwgourdxhdejwkhe)
# Compartido con otras apps — todas las tablas de esta llevan prefijo `home_`.
NEXT_PUBLIC_SUPABASE_URL=https://impscwgourdxhdejwkhe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# OPCIONAL. Origen público de la app: el `resource` del MCP y la base del metadata
# OAuth. Sin `NEXT_PUBLIC_` a propósito: solo lo lee el servidor, y sacarlo del
# header Host sería suplantable.
#
# Si no la pones: en Vercel se deriva de VERCEL_PROJECT_PRODUCTION_URL (el dominio
# estable de producción, que Vercel inyecta solo), y en local cae a
# http://localhost:3000. Ponla explícita cuando tengas dominio propio.
# APP_URL=https://tu-dominio.com

# Client ID(s) que pueden entrar al MCP, separados por coma. Es el `Client ID`
# (formato UUID) de Authentication → OAuth Apps, NO el secret. Supabase emite
# `aud: "authenticated"` para todo el proyecto —compartido con las apps ra_/adala_—
# así que la audiencia no prueba nada y esta lista es lo que de verdad acota.
# Vacío = cualquier cliente OAuth del proyecto.
MCP_OAUTH_CLIENT_IDS=78ae3b68-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# El Client SECRET del OAuth App NO es variable de entorno: va directo en Claude
# (Advanced settings del conector). Nunca en Vercel ni en el repo.

# Solo para `npm run db:types`. Se saca de https://supabase.com/dashboard/account/tokens
# NUNCA se usa en runtime ni se expone al navegador.
# SUPABASE_ACCESS_TOKEN=sbp_...
